"""
TuB Helfer-Orga – Kopfbereich im Stil der WDM-U13-Seite
--------------------------------------------------------
Einbinden in app.py:

    from tub_header import render_hero

    render_hero(
        titel_oben="TuB Volleyball",
        titel_akzent="Helfer-Orga",
        badge="Volleyball-Abteilung TuB Bocholt",
        event_name="Nächster Spieltag: U13 vs. Rhede",
        event_iso="2026-11-08T10:00:00",   # Countdown-Ziel
        event_ort="Sporthalle West · Bocholt",
        kacheln=[
            ("Nächster Spieltag", "So 08.11.2026"),
            ("Offene Aufgaben", "7 Helferdienste"),
            ("Deine Punkte", "42"),
            ("Rückmeldungen", "3 ausstehend"),
        ],
        hintergrundbild=None,  # optional: URL zu einem Mannschaftsfoto
    )

Die Werte für Spieltag, Aufgaben und Punkte kommen aus deiner Datenbank
(SQLAlchemy) – einfach vor dem Aufruf abfragen und hier übergeben.
"""

import html
import streamlit.components.v1 as components

FARBEN = {
    "bg": "#1b0f26",       # dunkles Lila (Hintergrund)
    "bg_karte": "#26163a", # Kacheln
    "akzent": "#c18ee0",   # helles Lila (Akzentschrift)
    "linie": "#3d2a52",    # Rahmen
    "text": "#ffffff",
    "text_leise": "#b9a6cc",
}


def build_hero_html(
    titel_oben: str,
    titel_akzent: str,
    badge: str,
    event_name: str,
    event_iso: str,
    event_ort: str,
    kacheln: list[tuple[str, str]],
    hintergrundbild: str | None = None,
) -> str:
    e = html.escape
    f = FARBEN
    bild_css = (
        f"linear-gradient(90deg, {f['bg']} 25%, rgba(27,15,38,.75) 60%, rgba(27,15,38,.55)),"
        f" url('{e(hintergrundbild)}') center/cover no-repeat"
        if hintergrundbild
        else f"radial-gradient(circle at 80% 30%, #3a1f55 0%, {f['bg']} 60%)"
    )
    kachel_html = "".join(
        f'<div class="kachel"><div class="k-label">{e(l)}</div>'
        f'<div class="k-wert">{e(w)}</div></div>'
        for l, w in kacheln
    )
    return f"""
<!DOCTYPE html><html><head>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Barlow+Condensed:wght@500;600;700&display=swap" rel="stylesheet">
<style>
  * {{ box-sizing: border-box; margin: 0; padding: 0; }}
  body {{ background: transparent; font-family: 'Barlow Condensed', sans-serif; color: {f['text']}; }}
  .hero {{ background: {bild_css}; border-radius: 14px; overflow: hidden; position: relative; }}
  .streifen {{ display: flex; height: 4px; }}
  .streifen div {{ flex: 1; }}
  .inhalt {{ padding: 34px 40px 30px; }}
  .badge {{ display: inline-block; background: #fff; color: #5a2d82; font-weight: 700;
            letter-spacing: .22em; font-size: 12px; padding: 7px 12px; text-transform: uppercase; }}
  h1 {{ font-family: 'Anton', sans-serif; font-weight: 400; line-height: .95;
        font-size: clamp(38px, 7vw, 72px); text-transform: uppercase; margin-top: 14px; }}
  h1 .akzent {{ color: {f['akzent']}; display: block; }}
  .event {{ margin-top: 18px; display: flex; flex-wrap: wrap; gap: 4px 14px; align-items: baseline; }}
  .event .name {{ font-size: 24px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }}
  .event .ort {{ font-size: 16px; color: {f['text_leise']}; letter-spacing: .14em; text-transform: uppercase; }}
  .countdown {{ display: flex; gap: 10px; margin-top: 18px; }}
  .cd {{ width: 74px; padding: 10px 0 8px; text-align: center; border: 1px solid {f['linie']};
         border-radius: 4px; background: rgba(255,255,255,.04); }}
  .cd b {{ display: block; font-family: 'Anton', sans-serif; font-weight: 400; font-size: 32px; }}
  .cd span {{ font-size: 11px; letter-spacing: .2em; color: {f['akzent']}; }}
  .kacheln {{ display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
              margin-top: 28px; border: 1px solid {f['linie']}; border-radius: 6px;
              background: {f['bg_karte']}; }}
  .kachel {{ padding: 14px 20px; border-left: 1px solid {f['linie']}; }}
  .kachel:first-child {{ border-left: none; }}
  .k-label {{ font-size: 11px; letter-spacing: .22em; color: {f['akzent']};
              text-transform: uppercase; font-weight: 700; }}
  .k-wert {{ font-size: 20px; font-weight: 700; margin-top: 4px; }}
  @media (max-width: 600px) {{
    .inhalt {{ padding: 24px 20px; }}
    .cd {{ width: 62px; }} .cd b {{ font-size: 26px; }}
    .kachel {{ border-left: none; border-top: 1px solid {f['linie']}; }}
    .kachel:first-child {{ border-top: none; }}
  }}
</style></head><body>
<div class="hero">
  <div class="streifen"><div style="background:#3c9a3c"></div><div style="background:#fff"></div><div style="background:#d32f2f"></div></div>
  <div class="inhalt">
    <span class="badge">{e(badge)}</span>
    <h1>{e(titel_oben)}<span class="akzent">{e(titel_akzent)}</span></h1>
    <div class="event"><span class="name">{e(event_name)}</span><span class="ort">{e(event_ort)}</span></div>
    <div class="countdown" id="cd" data-ziel="{e(event_iso)}">
      <div class="cd"><b id="t">–</b><span>TAGE</span></div>
      <div class="cd"><b id="h">–</b><span>STD.</span></div>
      <div class="cd"><b id="m">–</b><span>MIN.</span></div>
      <div class="cd"><b id="s">–</b><span>SEK.</span></div>
    </div>
    <div class="kacheln">{kachel_html}</div>
  </div>
</div>
<script>
  const ziel = new Date(document.getElementById('cd').dataset.ziel).getTime();
  const pad = n => String(n).padStart(2, '0');
  function tick() {{
    let d = Math.max(0, ziel - Date.now()) / 1000;
    document.getElementById('t').textContent = Math.floor(d / 86400);
    document.getElementById('h').textContent = pad(Math.floor(d % 86400 / 3600));
    document.getElementById('m').textContent = pad(Math.floor(d % 3600 / 60));
    document.getElementById('s').textContent = pad(Math.floor(d % 60));
  }}
  tick(); setInterval(tick, 1000);
</script>
</body></html>
"""


def render_hero(*args, hoehe: int = 500, **kwargs) -> None:
    """Zeichnet den Kopfbereich in Streamlit. 'hoehe' bei Bedarf anpassen."""
    components.html(build_hero_html(*args, **kwargs), height=hoehe, scrolling=False)
